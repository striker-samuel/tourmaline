// A lit placeholder cube and floor, sourced from a self-contained glTF.
// (Family path follows the importer's convention: content/models/<stem>/.)
reference -root -n 0 -source "content/models/cube/cube.geometry" -name "ROOT";
fileInfo -k "application" -v "tourmaline-tour;;;;;;;;;";
fileInfo -k "product" -v "Tourmaline;;;;;;;;;";
fileInfo -k "version" -v "1;;;;;;;;;";
materialAsset -default -name "default";
