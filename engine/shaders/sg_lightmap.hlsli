#pragma once
// 2D SG lightmap sampling + evaluation (static geometry). CPU mirror:
// Engine/GI/lightmap.h/.cpp. Included after common.hlsli.
//
// Storage: one shared atlas of 9 RGBA16F 2D textures (36 half slots =
// 12 lobes x RGB, lobe-major stream h = lobe*3 + channel). Chunks with
// 5/6/9 lobes use the prefix subset. Hardware bilinear filters the
// amplitudes BEFORE per-pixel evaluation (Order:1886 lineage).
//
// Lobe axes + sharpness are FIXED per lobe count (never per-texel data),
// generated by the same BakingLab rule as the CPU tables:
//   sharpness = log(0.65)*N / (minDP - 1.0001)
// Diffuse: Stephen Hill fitted clamped-cosine approximation.
// Specular: SG-warped NDF approximation (WarpDistributionSG + inner
// product + V + Fresnel + cosine at the lobe center).

// Chunk descriptor + buffer view: sg_lightmap_types.hlsli (included from
// common.hlsli; SgLmChunkGpu / SgLmChunkBuffer).

#define SG_LM_MAX_LOBES 12
#define SG_LM_LAYERS 9

// Fixed bases: MUST match smvk::gi::kBases (Engine/GI/lightmap.cpp).
// Y-up Fibonacci spirals; sharpness per count: 5->2.272914, 6->3.385227,
// 9->5.996703, 12->7.253499.
static const float3 SG_LM_AXES_5[5] = {
    float3( 0.60000000f,  0.80000000f,  0.00000000f),
    float3(-0.67580974f,  0.40000000f,  0.61909708f),
    float3( 0.08742572f,  0.00000000f, -0.99617104f),
    float3( 0.55764343f, -0.40000000f,  0.72734710f),
    float3(-0.59082809f, -0.80000000f, -0.10450917f)
};
static const float SG_LM_SHARP_5 = 2.272914f;

static const float3 SG_LM_AXES_6[6] = {
    float3( 0.55277080f,  0.83333333f,  0.00000000f),
    float3(-0.63858018f,  0.50000000f,  0.58499175f),
    float3( 0.08620293f,  0.16666667f, -0.98223789f),
    float3( 0.59992881f, -0.16666667f,  0.78250089f),
    float3(-0.85278689f, -0.50000000f, -0.15084599f),
    float3( 0.46640329f, -0.83333333f,  0.29668759f)
};
static const float SG_LM_SHARP_6 = 3.385227f;

static const float3 SG_LM_AXES_9[9] = {
    float3( 0.45812285f,  0.88888889f,  0.00000000f),
    float3(-0.54960231f,  0.66666667f,  0.50348074f),
    float3( 0.07831653f,  0.44444444f, -0.89237641f),
    float3( 0.59322548f,  0.22222222f,  0.77375759f),
    float3(-0.98471349f,  0.00000000f, -0.17418195f),
    float3( 0.82265807f, -0.22222222f, -0.52330773f),
    float3(-0.23255520f, -0.44444444f,  0.86509376f),
    float3(-0.34353981f, -0.66666667f, -0.66146500f),
    float3( 0.43032455f, -0.88888889f,  0.15715383f)
};
static const float SG_LM_SHARP_9 = 5.996703f;

static const float3 SG_LM_AXES_12[12] = {
    float3( 0.39965263f,  0.91666667f,  0.00000000f),
    float3(-0.48772367f,  0.75000000f,  0.44679483f),
    float3( 0.07101005f,  0.58333333f, -0.80912286f),
    float3( 0.55310703f,  0.41666667f,  0.72143018f),
    float3(-0.95344473f,  0.25000000f, -0.16865095f),
    float3( 0.84082048f,  0.08333333f, -0.53486117f),
    float3(-0.25870133f, -0.08333333f,  0.96235606f),
    float3(-0.44627131f, -0.25000000f, -0.85926825f),
    float3( 0.85389880f, -0.41666667f,  0.31184247f),
    float3(-0.75078384f, -0.58333333f,  0.30991265f),
    float3( 0.28034777f, -0.75000000f, -0.59908691f),
    float3( 0.11960958f, -0.91666667f,  0.38133420f)
};
static const float SG_LM_SHARP_12 = 7.253499f;

float3 SgLmAxis(uint lobeCount, uint lobe)
{
    [branch]
    if (lobeCount == 5u)
        return SG_LM_AXES_5[min(lobe, 4u)];
    if (lobeCount == 6u)
        return SG_LM_AXES_6[min(lobe, 5u)];
    if (lobeCount == 9u)
        return SG_LM_AXES_9[min(lobe, 8u)];
    return SG_LM_AXES_12[min(lobe, 11u)];
}

float SgLmSharpness(uint lobeCount)
{
    [branch]
    if (lobeCount == 5u)  return SG_LM_SHARP_5;
    if (lobeCount == 6u)  return SG_LM_SHARP_6;
    if (lobeCount == 9u)  return SG_LM_SHARP_9;
    return SG_LM_SHARP_12;
}

// Stephen Hill's fitted clamped-cosine irradiance for one lobe.
float3 SgLmIrradianceFitted(float3 amp, float3 axis, float sharpness, float3 n)
{
    const float muDotN = dot(axis, n);
    const float lambda = max(sharpness, 1e-4);
    const float c0 = 0.36;
    const float c1 = 1.0 / (4.0 * c0);
    const float eml = exp(-lambda);
    const float em2l = eml * eml;
    const float rl = 1.0 / lambda;
    const float scale = 1.0 + 2.0 * em2l - rl;
    const float bias = (eml - em2l) * rl - em2l;
    const float x = sqrt(max(1.0 - scale, 0.0));
    const float x0 = c0 * muDotN;
    const float x1 = c1 * x;
    const float nr = x0 + x1;
    const float y = (abs(x0) <= x1) ? nr * nr / x : saturate(muDotN);
    const float normIrr = scale * y + bias;
    return normIrr * (2.0 * 3.14159265 * amp / lambda);
}

// GGX V1 (Smith height-correlated visibility factor) at the lobe center.
float SgLmGgxV1(float m2, float nDotX)
{
    return 2.0 * nDotX / (nDotX + sqrt(m2 + (1.0 - m2) * nDotX * nDotX));
}

// SG-warped NDF specular for one lobe (BakingLab SpecularTermSGWarp).
float3 SgLmSpecularLobe(float3 amp, float3 axis, float sharpness,
    float3 n, float3 view, float roughness, float3 specAlbedo)
{
    const float m = clamp(roughness, 0.045, 1.0);
    const float m2 = m * m;
    const float ndfSharp = 2.0 / m2;
    const float ndfAmp = 1.0 / (3.14159265 * m2);
    const float nDotV = max(dot(n, view), 0.0);
    float3 warpAxis = reflect(-view, n);
    const float warpLen = length(warpAxis);
    warpAxis = warpLen > 1e-6 ? warpAxis / warpLen : n;
    const float warpSharp = ndfSharp / (4.0 * max(nDotV, 0.1));
    // SGInnerProduct(warpedNDF, lobe).
    const float3 sum = warpSharp * warpAxis + sharpness * axis;
    const float lp = length(sum);
    if (lp < 1e-6)
        return float3(0, 0, 0);
    const float expo = exp(lp - warpSharp - sharpness);
    const float other = 1.0 - exp(-2.0 * lp);
    float3 outC = ndfAmp * amp * expo * (2.0 * 3.14159265 * other / lp);
    const float nDotL = saturate(dot(n, warpAxis));
    float3 h = warpAxis + view;
    const float hLen = length(h);
    h = hLen > 1e-6 ? h / hLen : n;
    outC *= SgLmGgxV1(m2, nDotL) * SgLmGgxV1(m2, nDotV);
    outC *= specAlbedo + (1.0 - specAlbedo)
        * pow(1.0 - saturate(dot(warpAxis, h)), 5.0);
    outC *= saturate(dot(specAlbedo, 333.0));
    outC *= nDotL;
    return max(outC, float3(0, 0, 0));
}

// Chunk descriptor (SgLmChunkGpu) + buffer view live in
// sg_lightmap_types.hlsli (needed by FrameUniforms before this include).

// Unpacks up to lobeCount amplitudes from the 9 filtered atlas texels.
// Stream: half index h = lobe*3 + channel; texel t = h >> 2, slot h & 3.
void SgLmUnpack(float4 layers[SG_LM_LAYERS], uint lobeCount,
    out float3 amps[SG_LM_MAX_LOBES])
{
    [unroll]
    for (uint lobe = 0; lobe < SG_LM_MAX_LOBES; ++lobe)
        amps[lobe] = float3(0, 0, 0);
    [unroll]
    for (uint lobe = 0; lobe < SG_LM_MAX_LOBES; ++lobe)
    {
        if (lobe >= lobeCount) { break; }
        const uint h = lobe * 3;
        float rgb[3];
        [unroll]
        for (uint c = 0; c < 3; ++c)
        {
            const uint s = h + c;
            const uint t = s >> 2;
            const uint k = s & 3;
            rgb[c] = (k == 0) ? layers[t].x
                    : (k == 1) ? layers[t].y
                    : (k == 2) ? layers[t].z
                               : layers[t].w;
        }
        amps[lobe] = float3(rgb[0], rgb[1], rgb[2]);
    }
}

// Samples the frame's lightmap atlas for chunk `chunkIdx` at chunk-local
// uv [0,1] (the vertex's texCoord2-driven coordinate) and unpacks the
// lobes. The 9 atlas layers ride the bindless Texture2D array at
// frame.lmLayers[0..8]; samplers[2] is the linear clamp-to-edge default
// (atlas amplitudes must never wrap across chunk borders).
bool SgLmSampleChunk(FrameUniforms frame, uint chunkIdx, float2 uv,
    out float3 amps[SG_LM_MAX_LOBES])
{
    [unroll]
    for (uint lobe = 0; lobe < SG_LM_MAX_LOBES; ++lobe)
        amps[lobe] = float3(0, 0, 0);
    if (chunkIdx == 0xFFFFFFFFu || chunkIdx >= frame.lmChunkCount)
        return false;
    const SgLmChunkGpu chunk = frame.lmChunks.Get().chunks[chunkIdx];
    const uint lobeCount = uint(chunk.atlasInfo.z);
    if (lobeCount == 0u)
        return false;
    // Chunk-local -> atlas UV: (rectMin + uv * rectSize) / atlasSize.
    const float2 atlasUv = (chunk.rectMinSize.xy
        + uv * chunk.rectMinSize.zw) * chunk.atlasInfo.xy;
    float4 layers[SG_LM_LAYERS];
    [unroll]
    for (uint t = 0; t < SG_LM_LAYERS; ++t)
    {
        layers[t] = textures[
            NonUniformResourceIndex(frame.lmLayers[t])]
            .Sample(samplers[2], atlasUv);
    }
    SgLmUnpack(layers, lobeCount, amps);
    return true;
}

// Diffuse irradiance E(n) over the chunk's lobes (radiance units; caller
// applies albedo / PI).
float3 SgLmDiffuseIrradiance(float3 amps[SG_LM_MAX_LOBES], uint lobeCount,
    float3 n)
{
    const float sharp = SgLmSharpness(lobeCount);
    float3 sum = float3(0, 0, 0);
    [unroll]
    for (uint i = 0; i < SG_LM_MAX_LOBES; ++i)
    {
        if (i >= lobeCount) { break; }
        sum += SgLmIrradianceFitted(amps[i], SgLmAxis(lobeCount, i), sharp, n);
    }
    return sum;
}

// Rough-glossy specular over the chunk's lobes (warped-NDF SG product).
float3 SgLmSpecular(float3 amps[SG_LM_MAX_LOBES], uint lobeCount,
    float3 n, float3 view, float roughness, float3 specAlbedo)
{
    const float sharp = SgLmSharpness(lobeCount);
    float3 sum = float3(0, 0, 0);
    [unroll]
    for (uint i = 0; i < SG_LM_MAX_LOBES; ++i)
    {
        if (i >= lobeCount) { break; }
        sum += SgLmSpecularLobe(amps[i], SgLmAxis(lobeCount, i), sharp,
            n, view, roughness, specAlbedo);
    }
    return sum;
}
