# The sample's authored audio graph (docs/audio_graph.md): a bell
# tower ambience. One source (the shared pak's bells.wav, looping)
# through a low-pass "tone" shaping filter into an "chimes" envelope
# submix, into the master. Two cues: calm (the bells fade in slowly)
# and storm (loud + muffled — the low-pass closes down).
#
# This file is the whole asset: the topology, the exposed parameters
# and ALL of its cues. The generated project.h emits
# project::audiographs::forest (the AudioGraphKey) plus the per-cue
# constants project::audiocues::forest_calm / forest_storm.

version 1

node -name "bells" -type source -sound "content/audio/bells.wav" -gain 0.25 -loop on
node -name "tone" -type lpf -cutoff 2000 -order 2
node -name "chimes" -type gain -gain 0.0
node -name "master" -type gain -gain 1.0

connect -from "bells" -to "tone"
connect -from "tone" -to "chimes"
connect -from "chimes" -to "master"
connect -from "master" -to "output"

# The gameplay-facing surface: nothing else is settable or automated.
param -name "chimes" -node "chimes" -field gain
param -name "tone" -node "tone" -field cutoff

# The default cue (first): the bells fade in over four seconds. Scene autoplay is disabled to avoid a second voice.
cue -name "calm"
start -node "bells" -t 0
ramp -param "chimes" -t 0 -value 0.0
ramp -param "chimes" -t 4 -value 0.6

# The storm cue: full chimes, the tone closes down (a muffled bed the
# gameplay fades to — the audio-graph analog of AnimatorCrossFade).
cue -name "storm"
start -node "bells" -t 0
set -param "chimes" -t 0 -value 1.0
set -param "tone" -t 0 -value 400
