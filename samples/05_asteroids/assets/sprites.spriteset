# Original 8x8 pixel atlas, no third-party sprite sources.
spriteset 1
texture content/asteroids/sprites.png
size 256 256
grid ship 0 0 8 4 32 32
grid rock 0 128 8 3 32 32
grid effect 0 224 8 1 32 32
anim large 5 loop rock_0 rock_1 rock_2 rock_3 rock_4 rock_5 rock_6 rock_7
anim medium 7 loop rock_8 rock_9 rock_10 rock_11 rock_12 rock_13 rock_14 rock_15
anim small 10 loop rock_16 rock_17 rock_18 rock_19 rock_20 rock_21 rock_22 rock_23
anim explosion 15 once effect_1 effect_2 effect_3 effect_4 effect_5 effect_6 effect_7
