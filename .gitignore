# --- Bakery compiled binaries (proprietary, never push) ---
# Unity Bakery build outputs live here and must stay local-only.
/external/bakery-compiled/
/external/bakery_compiled/

# Local agent/dev notes (documentation not for the repo).
/notes/

# --- CMake-generated Visual Studio files (never commit) ---
# This repo is CMake-based (CMakeLists.txt is the source of truth).
# In-source configures pollute the tree with these; always build out-of-source.
# NOTE: already-tracked upstream project files (e.g. external/DirectXTex)
# stay tracked - gitignore only stops NEW generated files.
*.vcxproj
*.vcxproj.filters
*.slnx
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
DartConfiguration.tcl
CMakeCache.txt
Testing/
*.dir/

# CMake package-config files generated at configure time (in-source builds
# drop these next to the sources, e.g. external/meshoptimizer/).
meshoptimizerConfig.cmake
meshoptimizerConfigVersion.cmake

# --- Compiled shader outputs (build syncs these next to App.exe) ---
# HLSL sources live elsewhere; compiled *.spv under content/ and
# engine_resources/ are build products. Never commit them.
/content/
/engine_resources/
/external/FidelityFX-SDK-v1.1.4/docs
/external/FidelityFX-SDK-v1.1.4
/build-asan

# --- Tourmaline runtime products (never commit) ---
# pipeline_cache.bin: Vulkan pipeline-cache blob. Lives OUTSIDE the repo on
# the dedicated scratch disk (TOURMALINE_PIPELINE_CACHE_DIR, default
# F:/pipelinecache) — these ignores stay as belt-and-suspenders for stale
# working-dir leftovers and custom dirs pinned into the tree.
# exports/screenshot_*.png + dumps: headless TOURMALINE_CAPTURE / SSR / EVSM
# / WYSIWYG dumps (capture frame must land inside --bench). The tracked
# exports/lut_neutral.png stays tracked — gitignore never untracks it.
# Redirect bench/cook *.log output to out/logs/ (out/ is ignored wholesale).
/pipeline_cache.bin
pipeline_cache*.bin
/exports/screenshot_*.png
/exports/*dump*.png
/exports/ssr_*.png
/exports/evsm_*.png

# --- vendored SDK / data clones (build inputs, never source) ---
# Same convention as external/FidelityFX-SDK-v1.1.4 above: full upstream
# clones stay untracked; the build consumes them in place.
/external/FidelityFX-SDK/
/external/df_game_data/

/portfolio/

# --- project-pipeline build projects (the canonical content flow) ---
# cook_sponza.bat defaults the demo project to the USER'S Documents
# (%USERPROFILE%\Documents\Tourmaline\...), so the repo tree stays clean;
# this entry covers anyone overriding TOURMALINE_PROJECT_DIR to a
# repo-relative path. A project directory is SELF-CONTAINED (copy it to
# another machine and Project.exe build works with no external store).
/projects/
