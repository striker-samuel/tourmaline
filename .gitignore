# --- Tourmaline binary content (external store) ---
# Large scene binaries live in F:/content (TOURMALINE_CONTENT_DIR), not in git.
# The build syncs them next to App.exe. Never commit these paths.
/app/content/models/
/app/content/paks/


#Opencode
