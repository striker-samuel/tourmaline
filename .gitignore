## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/master/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Oo]bj/

# --- Fetched third-party trees (install_dependencies.ps1 / .sh) -----------
# The vendored trees moved OUT of git: install_dependencies.(ps1|sh) fetches
# them from pinned upstream archives (SHA256-verified). Only the tracked
# overlay files below stay in the repo; the fetch never overwrites those.
# NOTE: these rules must stay BELOW the unanchored VS-template patterns
# above ([Bb]in/, x64/, [Aa][Rr][Mm]/...) - last match wins.
/external/.downloads/
/external/SDL3-3.4.16/**
!/external/SDL3-3.4.16/.tourmaline-fetched
/external/dxc/**
!/external/dxc/.tourmaline-fetched
/external/VulkanMemoryAllocator/**
!/external/VulkanMemoryAllocator/.tourmaline-fetched
/external/stb/**
!/external/stb/.tourmaline-fetched
/external/tinygltf/**
!/external/tinygltf/.tourmaline-fetched
/external/box3d/**
!/external/box3d/.tourmaline-fetched
/external/zlib/**
!/external/zlib/.tourmaline-fetched
# SQLiteCpp: the tree + the sqlite3 amalgamation are fetched; the tracked
# overlays are the mixed-snapshot LICENSE/README + 4 pinned-modified sources
/external/SQLiteCpp/**
!/external/SQLiteCpp/LICENSE.txt
!/external/SQLiteCpp/README.md
!/external/SQLiteCpp/include/
!/external/SQLiteCpp/include/SQLiteCpp/
!/external/SQLiteCpp/include/SQLiteCpp/Database.h
!/external/SQLiteCpp/include/SQLiteCpp/Savepoint.h
!/external/SQLiteCpp/src/
!/external/SQLiteCpp/src/Column.cpp
!/external/SQLiteCpp/src/Savepoint.cpp
# embree: fetched; overlays = the trimmed root CMakeLists + the 3 generated
# config/hash headers (checked-in build products the trim relied on)
/external/embree/**
!/external/embree/CMakeLists.txt
!/external/embree/include/
!/external/embree/include/embree4/
!/external/embree/include/embree4/rtcore_config.h
!/external/embree/kernels/
!/external/embree/kernels/config.h
!/external/embree/kernels/hash.h
# optick: fetched; overlays = the vendored-patched root CMakeLists +
# OptickConfig.cmake.in + the 9 patched/added sources
/external/optick/**
!/external/optick/CMakeLists.txt
!/external/optick/tools/
!/external/optick/tools/OptickConfig.cmake.in
!/external/optick/src/
!/external/optick/src/optick.config.h
!/external/optick/src/optick.h
!/external/optick/src/optick_capi.cpp
!/external/optick/src/optick_capi.h
!/external/optick/src/optick_core.cpp
!/external/optick/src/optick_core.linux.h
!/external/optick/src/optick_gpu.d3d12.cpp
!/external/optick/src/optick_gpu.vulkan.cpp
!/external/optick/src/optick_memory.h
# imgui / lz4: fetched (imgui at the v1.92.3 docking sync, lz4 at the
# v1.10.0 release pair); the overlays are our hand-written CMakeLists
/external/imgui/**
!/external/imgui/CMakeLists.txt
/external/lz4/**
!/external/lz4/CMakeLists.txt
# xatlas: fetched; overlays = our CMakeLists + 3 vendored-modified files
/external/xatlas/**
!/external/xatlas/CMakeLists.txt
!/external/xatlas/.appveyor.yml
!/external/xatlas/README.md
!/external/xatlas/source/
!/external/xatlas/source/xatlas/
!/external/xatlas/source/xatlas/xatlas.cpp
# vk-headers-extra: NOT fetched - a single tracked vendored SDK header
# (the LunarG-generated vk_format_utils.h) covering distro libvulkan-dev
# packages that trim the utility headers (see engine/CMakeLists.txt).
/external/vk-headers-extra/**
!/external/vk-headers-extra/vulkan/
!/external/vk-headers-extra/vulkan/utility/
!/external/vk-headers-extra/vulkan/utility/vk_format_utils.h
# streamline: fetched (SDK zip subset); the overlay is our bin/x64/README.md
/external/streamline/**
!/external/streamline/bin/
!/external/streamline/bin/x64/
!/external/streamline/bin/x64/README.md
# nvngx_dlss.dll (the ~56 MB NGX DLSS snippet) arrives WITH the Streamline
# zip via install_dependencies, but git never carries it (its license terms
# forbid redistribution; see bin/x64/README.md). Missing it just disables
# DLSS-SR - the engine renders at native extent (verified headless).
/external/streamline/bin/x64/nvngx_dlss.dll
# directx-headers: fetched (Linux-only - DirectXTex's non-Win32 path
# includes DirectX-Headers' wsl/winadapter.h + directx/d3d12.h); the
# Windows build uses the SDK's own headers (see the root CMakeLists)
/external/directx-headers/**
# vulkan-headers: fetched (Linux-only - the full 1.4.357 symbol set ahead
# of older distro libvulkan-dev headers; Windows uses its SDK's own)
/external/vulkan-headers/**
# directxmath: fetched (Linux-only DirectXTex dep - DirectXPackedVector.h;
# Windows uses the SDK's)
/external/directxmath/**

